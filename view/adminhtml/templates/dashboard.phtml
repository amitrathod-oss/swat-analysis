            <section id="ahc-tab-exceptions" class="ahc-tab-panel"><div class="ahc-card"><h2>Exceptions (<?= $block->escapeHtml((string)($logs['exception_count'] ?? 0)) ?>)</h2><p class="ahc-sub">Sanitized and fingerprinted entries from the configured log window</p><table class="ahc-table"><thead><tr><th>Type</th><th>Count</th><th>First seen</th><th>Last seen</th><th>Source</th></tr></thead><tbody><?php foreach (($logs['exceptions'] ?? []) as $exception): if (!is_array($exception)) continue; ?><tr><td><?= $block->escapeHtml($block->displayValue($exception['exception_type'] ?? null)) ?></td><td><?= $block->escapeHtml($block->displayValue($exception['count'] ?? null)) ?></td><td><?= $block->escapeHtml($block->displayValue($exception['first_seen'] ?? null)) ?></td><td><?= $block->escapeHtml($block->displayValue($exception['last_seen'] ?? null)) ?></td><td><?= $block->escapeHtml($block->displayValue($exception['source'] ?? null)) ?></td></tr><?php endforeach; ?><?php if (empty($logs['exceptions'])): ?><tr><td colspan="5">No exceptions detected.</td></tr><?php endif; ?></tbody></table></div></section>
            <section id="ahc-tab-extensions" class="ahc-tab-panel"><div class="ahc-card"><h2>Extensions (<?= $block->escapeHtml((string)($extensions['count'] ?? 0)) ?> modules, <?= $block->escapeHtml((string)($extensions['library_count'] ?? 0)) ?> libraries)</h2><p class="ahc-sub">Complete local inventory from Magento module metadata and Composer runtime metadata. A missing version is reported as N/A, never guessed.</p><table class="ahc-table"><thead><tr><th>Name</th><th>Type</th><th>Composer package</th><th>Version</th></tr></thead><tbody><?php foreach ($extensionRows as $extension): if (!is_array($extension)) continue; ?><tr><td><?= $block->escapeHtml($block->displayValue($extension['name'] ?? null)) ?></td><td><?= $block->escapeHtml($block->displayValue($extension['type'] ?? null)) ?></td><td><?= $block->escapeHtml($block->displayValue($extension['package'] ?? null)) ?></td><td><?= $block->escapeHtml($block->displayValue($extension['version'] ?? null)) ?></td></tr><?php endforeach; ?><?php if ($extensionRows === []): ?><tr><td colspan="4">No extension metadata was collected.</td></tr><?php endif; ?></tbody></table></div></section>
            <section id="ahc-tab-alerts" class="ahc-tab-panel"><div class="ahc-card"><h2>Alerts</h2><p class="ahc-sub">Collector and analyzer execution errors</p><?php if (empty($report['scan_errors'])): ?><div class="ahc-good-check">✓</div><div class="ahc-center">No scan errors</div><?php else: ?><table class="ahc-table"><thead><tr><th>Component</th><th>Error</th></tr></thead><tbody><?php foreach ($report['scan_errors'] as $component => $message): ?><tr><td><?= $block->escapeHtml((string)$component) ?></td><td><?= $block->escapeHtml($block->displayValue($message)) ?></td></tr><?php endforeach; ?></tbody></table><?php endif; ?></div></section>
