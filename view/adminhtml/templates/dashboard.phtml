$report = $block->getReport();
$summary = is_array($report['summary'] ?? null) ? $report['summary'] : [];
$counts = is_array($report['severity_counts'] ?? null) ? $report['severity_counts'] : [];
$application = is_array($report['application'] ?? null) ? $report['application'] : [];
$scoreDetails = is_array($report['health_score_details'] ?? null) ? $report['health_score_details'] : [];
$domains = is_array($scoreDetails['domain_scores'] ?? null) ? $scoreDetails['domain_scores'] : [];
$findings = is_array($report['findings'] ?? null) ? $report['findings'] : [];
$collectors = is_array($report['collectors'] ?? null) ? $report['collectors'] : [];
$database = is_array($collectors['database_advanced']['metrics'] ?? null) ? $collectors['database_advanced']['metrics'] : [];
$system = is_array($collectors['system']['metrics'] ?? null) ? $collectors['system']['metrics'] : [];
$extensions = is_array($collectors['extensions']['metrics'] ?? null) ? $collectors['extensions']['metrics'] : [];
$composer = is_array($collectors['composer']['metrics'] ?? null) ? $collectors['composer']['metrics'] : [];
$patches = is_array($collectors['patches']['metrics'] ?? null) ? $collectors['patches']['metrics'] : [];
$logs = is_array($collectors['logs']['metrics'] ?? null) ? $collectors['logs']['metrics'] : [];
$store = is_array($collectors['store']['metrics'] ?? null) ? $collectors['store']['metrics'] : [];
$integrations = is_array($collectors['integrations']['metrics'] ?? null) ? $collectors['integrations']['metrics'] : [];
$history = is_array($report['history'] ?? null) ? $report['history'] : [];
$scanScope = is_array($summary['scan_scope'] ?? null) ? $summary['scan_scope'] : [];
$score = (int)($report['health_score'] ?? 0);
$recommendationCount = (int)($summary['findings_total'] ?? count($findings));
$securityFindings = array_filter($findings, static function ($finding): bool {
    return is_array($finding) && in_array((string)($finding['domain'] ?? ''), ['Security'], true)
        && in_array(strtolower((string)($finding['risk_level'] ?? '')), ['severe', 'high'], true);
});
$securityCount = count($securityFindings);
$disk = is_array($system['disk'] ?? null) ? $system['disk'] : [];
$freeBytes = (int)($disk['free_bytes'] ?? 0);
$totalBytes = (int)($disk['total_bytes'] ?? 0);
$freeGb = $freeBytes > 0 ? round($freeBytes / 1073741824, 1) : null;
$totalGb = $totalBytes > 0 ? round($totalBytes / 1073741824, 1) : null;
$recommendationTotal = max(1, $recommendationCount);
$severeEnd = round((int)($counts['severe'] ?? 0) / $recommendationTotal * 100, 2);
$highEnd = $severeEnd + round((int)($counts['high'] ?? 0) / $recommendationTotal * 100, 2);
$elevatedEnd = $highEnd + round((int)($counts['elevated'] ?? 0) / $recommendationTotal * 100, 2);
$mediumEnd = $elevatedEnd + round((int)($counts['medium'] ?? 0) / $recommendationTotal * 100, 2);
$lowEnd = $mediumEnd + round((int)($counts['low'] ?? 0) / $recommendationTotal * 100, 2);
$platformCount = (int)($extensions['platform_count'] ?? 0);
$customCount = (int)($extensions['custom_or_vendor_count'] ?? 0);
$extensionTotal = max(1, $platformCount + $customCount);
$platformEnd = round($platformCount / $extensionTotal * 100, 2);
$storeRows = is_array($store['stores'] ?? null) ? $store['stores'] : [];
$integrationRows = is_array($integrations['sources'] ?? null) ? $integrations['sources'] : [];
$extensionRows = is_array($extensions['inventory'] ?? null) ? $extensions['inventory'] : [];
$httpMetrics = is_array($collectors['http']['metrics'] ?? null) ? $collectors['http']['metrics'] : [];
$testedPageTypes = is_array($httpMetrics['tested_page_types'] ?? null) ? $httpMetrics['tested_page_types'] : [];
$projectName = (string)($report['report_profile']['customer_name'] ?? 'Magento project');
?>
