        <?php endif; ?>
        <div class="ahc-footer">Read-only Magento health assessment</div>
    </div>
</div>
<script>
require(['jquery'], function ($) {
    $('.ahc-admin').on('click', '[data-ahc-tab]', function (event) {
        event.preventDefault();
        var tab = $(this).data('ahc-tab');
        $('.ahc-tabs a').removeClass('active');
        $(this).addClass('active');
        $('.ahc-tab-panel').removeClass('active');
        $('#ahc-tab-' + tab).addClass('active');
        if (window.history && window.history.replaceState) {
            window.history.replaceState(null, '', '#' + tab);
        }
    });
    var initial = window.location.hash.replace('#', '');
    if (initial && $('[data-ahc-tab="' + initial + '"]').length) {
        $('[data-ahc-tab="' + initial + '"]').trigger('click');
    }
});
</script>
